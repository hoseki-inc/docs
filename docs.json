{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bitcoin Control Center",
  "colors": {
    "primary": "#F7931A",
    "light": "#FFB257",
    "dark": "#C46F0A"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Download",
          "icon": "download",
          "href": "https://github.com/hoseki-inc/bitcoin-control-center/releases"
        },
        {
          "anchor": "Looking for Prove?",
          "icon": "arrow-up-right",
          "href": "https://help.hoseki.app"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bitcoincontrolcenter.com"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/hoseki-inc/bitcoin-control-center"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/hoseki-inc/bitcoin-control-center",
      "website": "https://www.bitcoincontrolcenter.com"
    }
  },
  "description": "Help for Bitcoin Control Center: local-first, watch-only Bitcoin savings app. Not Prove."
}
